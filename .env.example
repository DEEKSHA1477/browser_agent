# Copy to .env (repository root) and fill in. Read by the backend only — never exposed to the frontend.

# --- LLM (required) ---------------------------------------------------------
LLM_PROVIDER=gemini                 # gemini | openai | ollama (local, no key)
# LLM_FALLBACK_PROVIDER=ollama      # use local Ollama when every Gemini model is busy / rate-limited
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen3:4b             # install: https://ollama.com, then `ollama pull qwen3:4b`
# OLLAMA_TIMEOUT_S=300              # local CPU inference is slow
# OLLAMA_VISION=false               # true only for vision models (e.g. qwen2.5vl)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash        # gemini-2.5-* is no longer available to new API keys
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite   # used when the main model is busy or rate-limited
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
LLM_TIMEOUT_S=60
VISION_MODE=auto                    # always | auto (screenshot on new pages / after failures) | off

# --- Agent --------------------------------------------------------------------
MAX_STEPS=40
MAX_CONSECUTIVE_FAILURES=4

# --- Browser ------------------------------------------------------------------
HEADLESS=false                      # keep false: the browser should be visible (and some sites block headless)
BROWSER_SLOW_MO_MS=80
NAVIGATION_TIMEOUT_MS=30000
SCREENSHOT_INTERVAL_S=1.0
MAX_BROWSER_SESSIONS=3
BROWSER_LOCALE=en-IN
BROWSER_TIMEZONE=Asia/Kolkata
SEARCH_ENGINE=duckduckgo            # duckduckgo | bing | google (Google Search usually CAPTCHAs automated browsers)
# DOWNLOAD_DIR=C:\Users\you\Downloads\nova-agent

# --- Navigation policy -----------------------------------------------------------
# Comma-separated. If ALLOWED_DOMAINS is set, the agent can ONLY visit those domains.
ALLOWED_DOMAINS=
BLOCKED_DOMAINS=
ALLOW_PRIVATE_NETWORK=false         # block localhost / LAN addresses

# --- Server -----------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
